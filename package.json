{
  "name": "nano-update-notifier",
  "version": "1.0.0",
  "description": "Update notifications for your CLI app. Zero dependencies.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HeversonSilva-gif/nano-update-notifier.git"
  },
  "bugs": {
    "url": "https://github.com/HeversonSilva-gif/nano-update-notifier/issues"
  },
  "homepage": "https://github.com/HeversonSilva-gif/nano-update-notifier#readme",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "license": "MIT",
  "keywords": [
    "update",
    "notifier",
    "notify",
    "cli",
    "zero-dependency"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {},
  "peerDependencies": {},
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/semver": "^7.7.1",
    "semver": "^7.6.3",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "update-notifier": "^7.3.1",
    "vitest": "^2.0.0"
  },
  "scripts": {
    "build": "tsup && node scripts/postbuild.mjs",
    "demo": "node examples/try-it.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.cjs-types.json",
    "check:size": "node scripts/check-size.mjs",
    "verify": "npm run build && npm run typecheck && npm test && npm run check:size",
    "prepublishOnly": "npm run verify"
  }
}
